# Copy to terraform.tfvars and fill in values
# cp terraform.tfvars.example terraform.tfvars

azure_region         = "eastus"
resource_group_name  = ""  # Leave empty to create navalansible-rg
vm_admin_username    = "azureadmin"
vm_admin_password    = "YourSecurePassword123!"
vm_size              = "Standard_B2s"
restrict_to_my_ip    = true
allowed_ip           = ""  # Override if auto-detect fails

# --- New Relic Infinite Tracing (Trace Observer) ---
# Read by scripts/deploy-navalansible.sh and passed into Ansible.
# newrelic_trace_observer_host = "2488764c-f48e-4517-9f59-984b4399e623.aws-us-east-1.tracing.edge.nr-data.net"
# newrelic_trace_observer_port = "443"

# --- Demo DB/Cache settings (OPTIONAL) ---
# These are passed into Ansible to configure the API (IIS) at deploy time.
# WARNING: tfvars is plaintext. For real environments use a secret store.

# api_database_provider = "Sqlite"   # or "PostgreSQL" / "SqlServer"
# api_conn_main = "Server=localhost\\SQLEXPRESS;Database=navalarchive;User Id=navalarchive;Password=...;TrustServerCertificate=True;Encrypt=False"
# api_conn_logs = "Server=localhost\\SQLEXPRESS;Database=navalarchive_logs;User Id=navalarchive;Password=...;TrustServerCertificate=True;Encrypt=False"
# mssql_sa_password = "YourSaPassword123!"  # SQL Server Express install (mixed mode)

# Redis is optional: if omitted/empty, API uses in-memory distributed cache for sessions.
# api_redis_configuration = "host:6379,password=..."
# api_redis_instance_name = "navalarchive:"

# Dynamic lists DB-query mode (rollout flag)
# api_dynamiclists_db_mode = "true"

# New Relic PostgreSQL on-host integration (optional, legacy): DB user new_relic + postgresql-config.yml.
# Applied only when you run deploy with -newrelic or -fullrun (New Relic infra playbook), not on a normal site deploy.
# newrelic_postgres_monitor_password = "generate-a-strong-password"  # creates PG role new_relic + nri-postgresql config

# New Relic Microsoft SQL Server on-host integration (optional): login new_relic + mssql-config.yml.
# newrelic_mssql_monitor_password = "generate-a-strong-password"
# newrelic_mssql_hostname = "navalansible-vm"
# newrelic_mssql_endpoint = "navalansible-vm"
# newrelic_mssql_port = "55295"  # optional; auto-discovered from registry when empty
# newrelic_mssql_query_monitoring = true  # Query Store + QPM (requires VIEW DATABASE STATE)
